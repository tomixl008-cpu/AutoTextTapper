<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- soft outer halo -->
    <item
        android:bottom="-4dp"
        android:left="-4dp"
        android:right="-4dp"
        android:top="-4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glow_green_halo" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- panel body -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hacker_surface" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/hacker_neon_green" />
        </shape>
    </item>
</layer-list>
